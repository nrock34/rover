# Required server configuration
API_URL=https://api.example.com/v1/
STRAPI_GRAPHQL_URL=https://cms.example.com/graphql
COOKIE_SECRET=replace-with-at-least-32-random-characters
ACS_JWT_SECRET=replace-with-the-backend-access-token-signing-secret

# Newsletter provider
KEILA_URL=https://newsletter.example.com/api/v1/contacts
KEILA_TKN=replace-with-a-keila-api-token

# Local-only preview routes. Keep false in production.
ENABLE_PREVIEW_ROUTES=false

# Build-time Sentry source-map upload (optional)
SENTRY_AUTH_TOKEN=
## Optional analytics: disabled for normal local development.
ANALYTICS_ENABLED=false
ANALYTICS_LOCAL_ENABLED=false
# Comma-separated hostnames, without scheme or port. Add production hostnames in Cloudflare.
ANALYTICS_HOSTS=localhost,127.0.0.1
UMAMI_URL=http://localhost:3001
# Create a website in Umami, then copy its UUID here.
UMAMI_WEBSITE_ID=
# Private, independent random values of at least 32 characters. Never use PUBLIC_* names.
ANALYTICS_ID_SECRET=
# Match the value on Strapi (Render's rwm-analytics environment group in production).
ANALYTICS_SERVICE_SECRET=
# Assign one of these application roles to people allowed to open /analytics.
ANALYTICS_VIEWER_ROLES=analytics-admin,super-admin
